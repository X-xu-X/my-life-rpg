# Install as /etc/game-of-life/monitor.env mode 0600; not in the release tree.
PRODUCTION_ENV_FILE=/etc/game-of-life/production.env
# HTTPS receiver must accept {service,alerts}; fill only after notification authorization.
ALERT_WEBHOOK_URL=https://replace-with-authorized-receiver.example/hook
# On the independent probe host only, use public-probe.env:
# PUBLIC_HTTPS_URL=https://replace-with-your-domain.example/
# Probe checks the page AND same-origin /service-status (API + database), not the page alone.
