# 只有占位符；实际文件不得入库。DB_URL 由 entrypoint 从 app-password 组装。
RELEASE_ID=replace-with-release-id
# Generate once per deployment; preserve across container rebuilds/releases. Different deployments must differ.
BACKUP_ID=replace-with-stable-deployment-id
DOMAIN=replace-with-your-domain.example
ACME_EMAIL=replace-with-your-email@example.com
SECRETS_DIR=/etc/game-of-life/secrets
OPS_CONFIG_DIR=/etc/game-of-life/ops
OPS_WORK_DIR=/var/lib/game-of-life
# 三个秘密文件：admin-password、app-password(>=24字符)、credential-keys.json。
# RUN_MODE=cloud；PUBLIC_ORIGIN=https://DOMAIN；API/worker 单进程。
# 不提供公共模型 Key，不设置 DEEPSEEK_API_KEY。

# 可选 compose.hosted.yml / compose.mail.yml；基础部署不加载、不启用服务。
# hosted-ai.json 为独立站点模型 secret_ref→Key 映射；mail-password 为 SMTP_SSL 密码。
# 邮件叠加文件才使用以下非秘密设置；真实密码不写在本文件。
# MAIL_HOST=replace-with-smtp-host
# MAIL_PORT=465
# MAIL_FROM=replace-with-sender@example.com
# MAIL_USERNAME=replace-with-smtp-account
