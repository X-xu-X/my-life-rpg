[Unit]
Description=Game of Life independent encrypted backup
After=network-online.target docker.service
Wants=network-online.target
OnFailure=game-of-life-backup-alert.service

[Service]
Type=oneshot
WorkingDirectory=/opt/game-of-life
EnvironmentFile=/etc/game-of-life/backup-runner.env
ExecStart=/bin/sh /opt/game-of-life/ops/run-backup.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/game-of-life
